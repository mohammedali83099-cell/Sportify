# Database Configuration (PostgreSQL with AsyncPG)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/sportify
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/sportify

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-this-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Resend Transactional Email (Optional - terminal logger fallback if empty)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Sportify <onboarding@resend.dev>

# Redis Ephemeral Store (Optional - in-memory fallback if empty)
REDIS_URL=redis://localhost:6379/0

# Media Uploads
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=100
